{
  schemaVersion: 1,
  server: { host: '0.0.0.0', port: 8098 },
  runtime: { interval: '5s', timeout: '4s', staleAfter: '120s', failureAfter: '0s', recoveryAfter: '0s' },
  uiDefaults: { theme: 'dark', optionsEnabled: true, autoDiagnostics: true },
  plugins: {
    directory: '/app/checks', allowHotReload: true, watch: false,
    enabled: ['custom.fetch-json', 'custom.mqtt-telemetry', 'custom.postgres-freshness', 'custom.modbus-register', 'custom.graphql-health', 'custom.prometheus-value'],
  },
  sources: {
    broker: { type: 'mqtt', url: 'mqtt://mqtt:1883', topics: ['lab/telemetry'] },
    database: { type: 'postgres', host: 'postgres', database: 'board_lab', usernameRef: 'dbUser', passwordRef: 'dbPassword', maxRows: 5 },
    metrics: { type: 'prometheus', url: 'http://fixtures:8080' },
  },
  checks: {
    api: { type: 'custom.fetch-json', allowPresentation: true, params: { url: 'http://fixtures:8080/health', timestampPath: 'updatedAt' } },
    temperature: { type: 'custom.mqtt-telemetry', source: 'broker', allowPresentation: true, params: { source: 'broker', topic: 'lab/telemetry', warning: 60, critical: 80 } },
    import: { type: 'custom.postgres-freshness', source: 'database', allowPresentation: true, params: {
      source: 'database', query: 'SELECT last_success_at FROM service_heartbeats WHERE service = $1',
      values: ['demo-import'], warningSeconds: 30, criticalSeconds: 60,
    } },
    register: { type: 'custom.modbus-register', allowPresentation: true, params: { host: 'fixtures', port: 1502, unitId: 1, address: 100, functionCode: 4, scale: 0.1, warning: 60, critical: 80 } },
    graphql: { type: 'custom.graphql-health', params: { url: 'http://fixtures:8080/graphql', query: 'query { health { ready } }' } },
    queue: { type: 'custom.prometheus-value', source: 'metrics', params: { source: 'metrics', query: 'lab_queue_depth', warning: 50, critical: 100 } },
  },
  services: [
    { id: 'pipeline', name: 'Import pipeline', group: 'Composite example', checks: [{ id: 'api' }, { id: 'import' }, { id: 'queue', required: false }] },
    { id: 'api', name: 'Fetch JSON', group: 'Protocol lab', checks: [{ id: 'api' }] },
    { id: 'mqtt', name: 'MQTT telemetry', group: 'Protocol lab', checks: [{ id: 'temperature' }] },
    { id: 'postgres', name: 'Postgres freshness', group: 'Protocol lab', checks: [{ id: 'import' }] },
    { id: 'modbus', name: 'Modbus register', group: 'Protocol lab', checks: [{ id: 'register' }] },
    { id: 'graphql', name: 'GraphQL health', group: 'Protocol lab', checks: [{ id: 'graphql' }] },
    { id: 'prometheus', name: 'Prometheus value', group: 'Protocol lab', checks: [{ id: 'queue' }] },
  ],
  demo: { enabled: false },
}
