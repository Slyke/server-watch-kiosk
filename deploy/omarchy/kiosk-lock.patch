+  function beginKioskLock() {
+    if (locked) return true
+    kioskMode = kioskEligible && Date.now() - kioskInfoAt < 3000
+    kioskAddress = kioskMode ? String(kioskInfo.address) : ""
+    if (beginLock()) return true
+    kioskMode = false
+    kioskAddress = ""
+    return false
+  }
+
+  // Query the active window directly: this compositor version does not
+  // populate Quickshell's activeToplevel even while Chromium has focus.
+  Process {
+    id: kioskWindowCheck
+    command: ["hyprctl", "-j", "activewindow"]
+    stdout: StdioCollector { id: kioskWindowOutput; waitForEnd: true }
+    onExited: function(exitCode) {
+      if (root.locked) return
+      root.kioskInfo = null
+      if (exitCode !== 0) return
+      try {
+        var info = JSON.parse(kioskWindowOutput.text)
+        root.kioskInfo = {
+          class: info.class, fullscreen: info.fullscreen, address: info.address
+        }
+        root.kioskInfoAt = Date.now()
+      } catch (error) { root.kioskInfo = null }
+    }
+  }
+
+  Timer {
+    interval: 1000
+    running: !root.locked
+    repeat: true
+    triggeredOnStart: true
+    onTriggered: if (!kioskWindowCheck.running) kioskWindowCheck.running = true
+  }
+
+  // Ignore browser idle inhibitors: this measures actual human input.
+  IdleMonitor {
+    id: kioskIdle
+    enabled: !root.locked && root.kioskIdleArmed
+    timeout: root.kioskIdleSeconds
+    respectInhibitors: false
+  }
+
+  // Close the transparent view if a different window could become visible.
+  // The compositor lock remains held; only password authentication unlocks it.
+  Connections {
+    target: Hyprland
+    function onRawEvent(event) {
+      if (!root.kioskMode || !root.locked) return
+      var value = String(event.data || "").split(",")[0].replace(/^0x/, "")
+      var address = root.kioskAddress.replace(/^0x/, "")
+      if (event.name === "openwindow"
+          || (event.name === "closewindow" && value === address)
+          || (event.name === "activewindowv2" && value && value !== address)
+          || event.name === "fullscreen"
+          || event.name === "workspacev2") root.kioskMode = false
+    }
+  }
