{
  schemaVersion: 1,
  // LAN always requires SERVICE_BOARD_UNLOCK_CODE for diagnostics and controls.
  // Set localLock: true to require the same code on localhost too.
  server: { host: '0.0.0.0', port: 8098, localLock: false },
  runtime: { interval: '30s', timeout: '5s', staleAfter: '120s', failureAfter: '30s', recoveryAfter: '30s' },
  uiDefaults: {
    // Default theme: reference (example_pics), dark/light (Phox), contrast, tron.
    // Each browser can override this in Options → Theme.
    theme: 'reference',
    autoDiagnostics: true,
    sortMode: 'severity',
    splitRatio: 0.60,
    optionsEnabled: true,
    customOrders: {},
  },
  plugins: {
    directory: './checks',
    enabled: [],
    allowHotReload: true,
    watch: false,
  },
  sources: {},
  checks: {},
  services: [],
  // Offline fixtures: no upstream connections or module imports.
  demo: { enabled: true, scenario: 'mixed' },
}
