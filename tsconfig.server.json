{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "src/server/**/*",
    "src/shared/**/*",
    "src/demo/**/*"
  ],
  "exclude": [
    "src/web/**/*"
  ]
}