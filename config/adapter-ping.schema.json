{
  "$ref": "#/definitions/adapter-ping",
  "definitions": {
    "adapter-ping": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-zA-Z0-9_.:[\\]-]+$"
        },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        },
        "warningLatency": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?(?:ms|s|m|h|d)$",
          "default": "250ms"
        },
        "criticalLoss": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 100
        }
      },
      "required": [
        "host"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
