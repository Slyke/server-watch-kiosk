{
  "$ref": "#/definitions/adapter-tls",
  "definitions": {
    "adapter-tls": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-zA-Z0-9_.:[\\]-]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 443
        },
        "servername": {
          "$ref": "#/definitions/adapter-tls/properties/host"
        },
        "caFile": {
          "type": "string",
          "minLength": 1
        },
        "warningBefore": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?(?:ms|s|m|h|d)$",
          "default": "14d"
        }
      },
      "required": [
        "host"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
