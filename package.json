{
  "name": "service-watcher-kiosk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/write-build-info.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "start": "node dist/server/main.js",
    "demo": "node dist/server/main.js --demo",
    "schema": "tsx scripts/write-schemas.ts",
    "error-add": "node scripts/error_gen.cjs --action add --error-file ./src/server/logging/errors.json",
    "error-validate": "node scripts/error_gen.cjs --action validate --error-file ./src/server/logging/errors.json",
    "test:docker": "tsx --test tests/docker/*.test.ts"
  },
  "dependencies": {
    "@kubernetes/client-node": "2.0.0",
    "ajv": "8.20.0",
    "express": "5.2.1",
    "json5": "2.2.3",
    "mqtt": "5.16.0",
    "pg": "8.23.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "zod-to-json-schema": "3.25.2"
  }
}
